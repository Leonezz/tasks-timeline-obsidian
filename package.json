{
	"name": "tasks-timeline-obsidian",
	"version": "0.1.4",
	"description": "This is a timeline style viewer for your tasks",
	"main": "src/main.ts",
	"type": "module",
	"scripts": {
		"dev": "cp manifest.json ExampleVault/.obsidian/plugins/tasks-timeline-obsidian/ && vite build --watch --mode=development",
		"build": "vite build && cp manifest.json ./dist/",
		"release": "git tag -a %npm_config_tag% -m '%npm_config_tag%' && git push origin %npm_config_tag%",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:e2e": "jest tests/e2e",
		"test:unit": "jest tests/unit",
		"test:vault": "jest tests/e2e/vault.test.ts --verbose"
	},
	"keywords": [],
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/luxon": "^3.7.1",
		"@types/node": "^16.18.126",
		"@types/parsimmon": "^1.10.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"builtin-modules": "^5.0.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.3",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"jiti": "2.6.1",
		"ts-jest": "^29.4.6",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.35.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.78.0",
		"@google/genai": "^1.42.0",
		"@modelcontextprotocol/sdk": "^1.27.0",
		"@tasks-timeline/components": "latest",
		"ahooks": "^3.9.6",
		"emoji-regex": "^10.6.0",
		"luxon": "^3.7.2",
		"obsidian": "latest",
		"openai": "^6.24.0",
		"parsimmon": "^1.18.1",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
