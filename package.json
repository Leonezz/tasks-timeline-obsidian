{
	"name": "tasks-timeline-obsidian",
	"version": "0.2.4",
	"description": "View and manage vault tasks on a timeline.",
	"main": "dist/main.js",
	"type": "module",
	"files": [
		"dist",
		"manifest.json",
		"versions.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "cp manifest.json ExampleVault/.obsidian/plugins/tasks-timeline/ && vite build --watch --mode=development",
		"build": "vite build && cp manifest.json ./dist/",
		"release": "git tag -a $npm_package_version -m $npm_package_version && git push origin $npm_package_version",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:e2e": "jest tests/e2e",
		"test:unit": "jest tests/unit",
		"test:vault": "jest tests/e2e/vault.test.ts --verbose"
	},
	"keywords": [],
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/luxon": "^3.7.1",
		"@types/node": "^16.18.126",
		"@types/parsimmon": "^1.10.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"builtin-modules": "^5.0.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.3",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"jiti": "2.6.1",
		"obsidian": "1.12.3",
		"ts-jest": "^29.4.6",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.35.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@tasks-timeline/components": "0.4.20",
		"emoji-regex": "^10.6.0",
		"luxon": "^3.7.2",
